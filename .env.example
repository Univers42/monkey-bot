# Server
PORT=3000

# Playwright / Chromium
CHROMIUM_PATH=/usr/bin/chromium-browser
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Optional: absolute or repo-relative path to targets JSON
# Default: config/targets.json (merged with config/targets.local.json if present)
# MONKEY_BOT_TARGETS_FILE=config/targets.json

# Target auth credentials (never commit real values)
# MONKEY_BOT_TARGET_USER=
# MONKEY_BOT_TARGET_PASSWORD=
