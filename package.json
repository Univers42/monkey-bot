{
  "name": "monkey-bot",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "description": "TypeScript Playwright bot server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
