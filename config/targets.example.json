{
  "defaults": {
    "timeoutMs": 20000
  },
  "targets": {
    "local-app": {
      "url": "http://localhost:5173/",
      "description": "Local Univers42 app under test",
      "formSelector": "form",
      "fieldSelector": "input[type='text'], input:not([type]), textarea",
      "submitSelector": "button[type='submit'], input[type='submit'], button",
      "waitForSelector": "form",
      "timeoutMs": 20000
    },
    "staging-app": {
      "url": "https://staging.example.univers42/",
      "description": "Staging Univers42 app (replace with a real org URL)",
      "formSelector": "form",
      "fieldSelector": "input[name='q']",
      "submitSelector": "button[type='submit']"
    }
  }
}
